NODE_ENV=development
PORT=4000
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=2h

# Persistencia: si DATABASE_URL está definida se usa PostgreSQL (Supabase).
# Si no, se usa el fallback SQLite local indicado en DB_STORAGE.
DATABASE_URL=
SUPABASE_DB_URL=
DB_STORAGE=./data/bytepro.sqlite
DB_SSL=true

# Credenciales públicas de Supabase para Realtime
SUPABASE_URL=
SUPABASE_ANON_KEY=

PAGE_SIZE_DEFAULT=12
PAGE_SIZE_MAX=24
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
TAX_RATE=0.13
CURRENCY=BOB
STOCK_LOCK_MINUTES=10
